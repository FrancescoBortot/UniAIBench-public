{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FrancescoBortot/UniAIBench-public/raw/main/schemas/benchmark-config.schema.json",
  "title": "UniAIBench benchmark configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider_calls_authorized", "benchmark_id", "access_date",
    "prompt_file", "prompt_id", "prompt_language", "dataset_root",
    "dataset_item_prefix", "session_directory_template",
    "exercise_filename_glob", "exercise_filename_regex",
    "expected_exercises_per_session", "output_root", "sessions",
    "repetitions", "global_concurrency", "request_timeout_seconds",
    "max_attempts", "retry_base_seconds", "shuffle_seed",
    "exam_metadata", "models"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "provider_calls_authorized": {"type": "boolean"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "access_date": {"type": "string", "minLength": 10},
    "prompt_file": {"type": "string", "minLength": 1},
    "prompt_id": {"type": "string", "minLength": 1},
    "prompt_language": {"type": "string", "minLength": 2},
    "dataset_root": {"type": "string", "minLength": 1},
    "dataset_item_prefix": {"type": "string", "minLength": 1},
    "session_directory_template": {"type": "string", "minLength": 1},
    "exercise_filename_glob": {"type": "string", "minLength": 1},
    "exercise_filename_regex": {"type": "string", "minLength": 1},
    "expected_exercises_per_session": {"type": "integer", "minimum": 1},
    "output_root": {"type": "string", "minLength": 1},
    "sessions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "exercise_numbers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "task_unit": {"enum": ["exercise", "exam"]},
    "repetitions": {"type": "integer", "minimum": 1},
    "global_concurrency": {"type": "integer", "minimum": 1},
    "request_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
    "max_attempts": {"type": "integer", "minimum": 1},
    "retry_base_seconds": {"type": "number", "minimum": 0},
    "shuffle_seed": {"type": "integer"},
    "exam_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "academic_year", "exam_name", "degree_program", "institution", "subject", "topic", "allowed_tools", "web_allowed", "allowed_materials"],
      "properties": {
        "year": {"type": "integer", "minimum": 1900},
        "academic_year": {"type": "string", "minLength": 1},
        "exam_name": {"type": "string", "minLength": 1},
        "degree_program": {"type": "string", "minLength": 1},
        "institution": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "allowed_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "web_allowed": {"type": "boolean"},
        "allowed_materials": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "display_name", "model_id", "model_mode", "endpoint", "concurrency", "max_output_tokens"],
        "properties": {
          "provider": {"enum": ["openai", "anthropic", "google", "kimi", "deepseek", "xai"]},
          "display_name": {"type": "string", "minLength": 1},
          "model_id": {"type": "string", "minLength": 1},
          "output_slug": {"type": "string", "minLength": 1},
          "model_mode": {"type": "string", "minLength": 1},
          "endpoint": {"type": "string", "minLength": 1},
          "concurrency": {"type": "integer", "minimum": 1},
          "max_output_tokens": {"type": "integer", "minimum": 1},
          "reasoning_effort": {"type": ["string", "null"]},
          "thinking_level": {"type": ["string", "null"]},
          "thinking_mode": {"type": ["string", "null"]},
          "pricing_usd_per_million": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["input", "output"],
            "properties": {
              "input": {"type": "number", "minimum": 0},
              "output": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    }
  }
}
