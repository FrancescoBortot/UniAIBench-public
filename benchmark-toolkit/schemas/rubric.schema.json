{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FrancescoBortot/UniAIBench-public/v1.0/benchmark-toolkit/schemas/rubric.schema.json",
  "title": "Reusable atomic rubric",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rubric_version",
    "judge_spec_version",
    "item_id",
    "subject",
    "domain_profile",
    "created_without_model_answers",
    "frozen",
    "reference_status",
    "subproblems",
    "atomic_criteria",
    "dimension_applicability",
    "dimension_point_budget",
    "rubric_specific_caps",
    "human_review_triggers",
    "human_approval"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "rubric_version": {"type": "string", "minLength": 1},
    "judge_spec_version": {"type": "string", "minLength": 1},
    "item_id": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "domain_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discipline", "topic", "task_type", "domain_specific_fields"],
      "properties": {
        "discipline": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "task_type": {"type": "string", "minLength": 1},
        "domain_specific_fields": {"type": "object"}
      }
    },
    "created_without_model_answers": {"type": "boolean"},
    "frozen": {"type": "boolean"},
    "reference_status": {
      "enum": ["unverified", "verified", "contested", "not_available"]
    },
    "reference_notes": {"type": "string"},
    "subproblems": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/subproblem"}
    },
    "atomic_criteria": {
      "type": "array",
      "items": {"$ref": "#/$defs/criterion"}
    },
    "dimension_applicability": {"$ref": "#/$defs/dimensionApplicability"},
    "dimension_point_budget": {"$ref": "#/$defs/dimensionBudget"},
    "rubric_specific_caps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cap", "condition", "reason"],
        "properties": {
          "cap": {"type": "number", "minimum": 0, "maximum": 100},
          "condition": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "human_review_triggers": {
      "type": "array",
      "items": {"type": "string"}
    },
    "human_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "reviewer", "date"],
      "properties": {
        "approved": {"type": "boolean"},
        "reviewer": {"type": "string"},
        "date": {"type": "string"}
      }
    }
  },
  "$defs": {
    "stringArray": {"type": "array", "items": {"type": "string"}},
    "subproblem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "weight", "request", "expected_results", "required_conditions", "accepted_equivalences", "accepted_alternative_methods"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "request": {"type": "string"},
        "expected_results": {"$ref": "#/$defs/stringArray"},
        "required_conditions": {"$ref": "#/$defs/stringArray"},
        "accepted_equivalences": {"$ref": "#/$defs/stringArray"},
        "accepted_alternative_methods": {"$ref": "#/$defs/stringArray"}
      }
    },
    "partialCreditRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credit_fraction", "anchor"],
      "properties": {
        "credit_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "anchor": {"type": "string"}
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "subproblem_id", "primary_dimension", "max_points", "description", "full_credit_evidence", "partial_credit_rules", "zero_credit_conditions", "accepted_equivalences", "accepted_alternative_methods", "propagated_error_policy"],
      "properties": {
        "criterion_id": {"type": "string", "minLength": 1},
        "subproblem_id": {"type": "string", "minLength": 1},
        "primary_dimension": {"enum": ["T1", "T2", "T3", "T4", "T5", "T6", "T7", "T8"]},
        "max_points": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
        "description": {"type": "string"},
        "full_credit_evidence": {"$ref": "#/$defs/stringArray"},
        "partial_credit_rules": {"type": "array", "items": {"$ref": "#/$defs/partialCreditRule"}},
        "zero_credit_conditions": {"$ref": "#/$defs/stringArray"},
        "accepted_equivalences": {"$ref": "#/$defs/stringArray"},
        "accepted_alternative_methods": {"$ref": "#/$defs/stringArray"},
        "propagated_error_policy": {"type": "string"}
      }
    },
    "dimensionApplicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["T1", "T2", "T3", "T4", "T5", "T6", "T7", "T8"],
      "properties": {
        "T1": {"enum": ["applicable", "not_applicable"]},
        "T2": {"enum": ["applicable", "not_applicable"]},
        "T3": {"enum": ["applicable", "not_applicable"]},
        "T4": {"enum": ["applicable", "not_applicable"]},
        "T5": {"enum": ["applicable", "not_applicable"]},
        "T6": {"enum": ["applicable", "not_applicable"]},
        "T7": {"enum": ["applicable", "not_applicable"]},
        "T8": {"enum": ["applicable", "not_applicable"]}
      }
    },
    "dimensionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["T1", "T2", "T3", "T4", "T5", "T6", "T7", "T8"],
      "properties": {
        "T1": {"type": "number", "minimum": 0},
        "T2": {"type": "number", "minimum": 0},
        "T3": {"type": "number", "minimum": 0},
        "T4": {"type": "number", "minimum": 0},
        "T5": {"type": "number", "minimum": 0},
        "T6": {"type": "number", "minimum": 0},
        "T7": {"type": "number", "minimum": 0},
        "T8": {"type": "number", "minimum": 0}
      }
    }
  }
}
