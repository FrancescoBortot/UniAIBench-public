{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FrancescoBortot/UniAIBench-public/v1.0/benchmark-toolkit/schemas/aggregation-config.schema.json",
  "title": "Benchmark aggregation configuration",
  "description": "Frozen contract for reducing validated unblinded response records into reproducible aggregate results.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "aggregation_id",
    "status",
    "input",
    "fields",
    "eligibility",
    "repetition_aggregation",
    "missing_data",
    "item_aggregation",
    "bootstrap",
    "outputs"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "aggregation_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "status": {
      "enum": [
        "draft",
        "frozen"
      ]
    },
    "input": {
      "$ref": "#/$defs/input"
    },
    "fields": {
      "$ref": "#/$defs/fields"
    },
    "eligibility": {
      "$ref": "#/$defs/eligibility"
    },
    "repetition_aggregation": {
      "$ref": "#/$defs/repetitionAggregation"
    },
    "missing_data": {
      "$ref": "#/$defs/missingData"
    },
    "item_aggregation": {
      "$ref": "#/$defs/itemAggregation"
    },
    "bootstrap": {
      "$ref": "#/$defs/bootstrap"
    },
    "outputs": {
      "$ref": "#/$defs/outputs"
    },
    "resources": {
      "type": "array",
      "description": "Optional declarations reserved for resource-metric extensions. The v1 aggregate_results.py command does not calculate them.",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/resourceDeclaration"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unblinded_results_path",
        "unblinded_results_sha256"
      ],
      "properties": {
        "unblinded_results_path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "unblinded_results_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_field",
        "item_field",
        "repetition_field",
        "score_field"
      ],
      "properties": {
        "system_field": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "item_field": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "repetition_field": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "score_field": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "accepted_values"
      ],
      "properties": {
        "field": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Optional dotted field path. Null disables this additional filter; the unblinding gate still requires complete, valid, resolved judgments."
        },
        "accepted_values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {}
        }
      }
    },
    "repetitionAggregation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "expected_repetitions_per_cell"
      ],
      "properties": {
        "method": {
          "enum": [
            "mean",
            "median",
            "first_authoritative"
          ]
        },
        "expected_repetitions_per_cell": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "missingData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy"
      ],
      "properties": {
        "policy": {
          "enum": [
            "fail",
            "exclude_cell",
            "available_case"
          ]
        }
      }
    },
    "itemAggregation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "weights"
      ],
      "properties": {
        "method": {
          "enum": [
            "mean",
            "weighted_mean"
          ]
        },
        "weights": {
          "type": "object",
          "description": "Positive, predeclared weights keyed by item_id. Leave empty when method is mean.",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "method",
        "samples",
        "confidence_level",
        "seed",
        "resampling_unit"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "method": {
          "enum": [
            "percentile"
          ]
        },
        "samples": {
          "type": "integer",
          "minimum": 1
        },
        "confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "seed": {
          "type": "integer"
        },
        "resampling_unit": {
          "enum": [
            "item"
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "system_table_csv",
        "cell_table_csv",
        "summary_json"
      ],
      "properties": {
        "directory": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "system_table_csv": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "cell_table_csv": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "summary_json": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "resourceDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "field",
        "unit"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "field": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "unit": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
