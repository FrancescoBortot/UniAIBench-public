{
  "$schema": "https://raw.githubusercontent.com/FrancescoBortot/UniAIBench-public/v1.0/benchmark-toolkit/schemas/benchmark-config.schema.json",
  "provider_calls_authorized": false,
  "benchmark_id": "replace_with_a_unique_google_benchmark_id",
  "access_date": "<YYYY-MM-DD>",
  "prompt_file": "../prompts/solver-prompt.md",
  "prompt_id": "solver_prompt_v1",
  "prompt_language": "en",
  "dataset_root": "../local_data/items_2026",
  "dataset_item_prefix": "benchmark_item",
  "session_directory_template": "sessions/{session}",
  "item_filename_glob": "item_*.txt",
  "item_filename_regex": "item_(\\d+)\\.txt",
  "expected_items_per_session": 3,
  "output_root": "../local_outputs",
  "sessions": ["session_1"],
  "repetitions": 1,
  "global_concurrency": 1,
  "request_timeout_seconds": 900,
  "max_attempts": 2,
  "retry_base_seconds": 2.0,
  "shuffle_seed": 20260101,
  "assessment_metadata": {
    "year": 2026,
    "name": "<ASSESSMENT_NAME>",
    "context": "<CONTEXT_OR_POPULATION>",
    "domain": "<DOMAIN>",
    "subject": "<SUBJECT>",
    "topic": "<TOPIC>",
    "allowed_tools": [],
    "web_allowed": false,
    "allowed_materials": []
  },
  "models": [
    {
      "provider": "google",
      "display_name": "<MODEL_DISPLAY_NAME>",
      "model_id": "<PROVIDER_MODEL_ID>",
      "model_mode": "<VERSIONED_MODE>",
      "endpoint": "Google Gen AI generateContent",
      "concurrency": 1,
      "max_output_tokens": 16000,
      "thinking_level": null
    }
  ]
}
