{
  "$schema": "../schemas/benchmark-config.schema.json",
  "provider_calls_authorized": false,
  "benchmark_id": "replace_with_a_unique_google_benchmark_id",
  "access_date": "<YYYY-MM-DD>",
  "prompt_file": "prompts/solver-prompt.md",
  "prompt_id": "solver_prompt_v1",
  "prompt_language": "en",
  "dataset_root": "local_data/items_2026",
  "dataset_item_prefix": "exercise",
  "session_directory_template": "sessions/{session}",
  "exercise_filename_glob": "exercise_*.txt",
  "exercise_filename_regex": "exercise_(\\d+)\\.txt",
  "expected_exercises_per_session": 3,
  "output_root": "local_outputs",
  "sessions": ["session_1"],
  "repetitions": 1,
  "global_concurrency": 1,
  "request_timeout_seconds": 900,
  "max_attempts": 2,
  "retry_base_seconds": 2.0,
  "shuffle_seed": 20260101,
  "exam_metadata": {
    "year": 2026,
    "academic_year": "2025/2026",
    "exam_name": "<ASSESSMENT_NAME>",
    "degree_program": "<PROGRAMME>",
    "institution": "<INSTITUTION>",
    "subject": "<SUBJECT>",
    "topic": "<TOPIC>",
    "allowed_tools": [],
    "web_allowed": false,
    "allowed_materials": []
  },
  "models": [
    {
      "provider": "google",
      "display_name": "<MODEL_DISPLAY_NAME>",
      "model_id": "<PROVIDER_MODEL_ID>",
      "model_mode": "<VERSIONED_MODE>",
      "endpoint": "Google Gen AI generateContent",
      "concurrency": 1,
      "max_output_tokens": 16000,
      "thinking_level": null
    }
  ]
}
